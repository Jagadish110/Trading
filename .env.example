# Copy this file to .env and fill in your own values. Never commit .env.
KITE_API_KEY=
KITE_API_SECRET=

# Which broker the bot connects to for live prices and orders: zerodha or groww.
BROKER=zerodha

# Groww Trade API (only if BROKER=groww). With the TOTP secret the bot logs in
# by itself each day. Without it, use GROWW_API_SECRET and approve the key on
# Groww's site every morning.
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GROWW_API_SECRET=

# Optional: Telegram alerts (see "Telegram alerts" in the README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rupees the Telegram assistant sizes trades from.
TRADE_CAPITAL=20000

# Real orders are refused unless this says yes AND you start with --live.
LIVE_TRADING=no
